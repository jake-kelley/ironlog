# Copy to .env and fill in real values. NEVER commit .env to git (.gitignore already excludes it).
# Generate strong values, e.g.:  openssl rand -base64 24

# --- ClickHouse ---
CH_ADMIN_USER=siem_admin
CH_ADMIN_PASSWORD=CHANGE_ME
CH_VECTOR_PASSWORD=CHANGE_ME
CH_GRAFANA_ANALYST_PASSWORD=CHANGE_ME
CH_GRAFANA_AUDITOR_PASSWORD=CHANGE_ME
CH_HYPERDX_PASSWORD=CHANGE_ME

# --- Keycloak ---
KC_DB_PASSWORD=CHANGE_ME
KC_ADMIN_USER=kcadmin
KC_ADMIN_PASSWORD=CHANGE_ME
# Local testing: http://keycloak:8080 (and add "127.0.0.1 keycloak" to your /etc/hosts
# so your browser and the Grafana container resolve the same hostname).
# Production: https://sso.yourdomain.example
KC_HOSTNAME=http://keycloak:8080
KC_PUBLIC_URL=http://keycloak:8080

# --- Grafana ---
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_ADMIN_USER=breakglass_admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Must match the client secret set on the "grafana" client in Keycloak
# (keycloak/realm-export/siem-realm.json imports a placeholder — rotate it in the
# Keycloak admin console after first boot, then update this value).
GRAFANA_OAUTH_SECRET=CHANGE_ME_GRAFANA_CLIENT_SECRET

# --- HyperDX (search UI; behind oauth2-proxy SSO gate on :8081) ---
# Client secret for the "hyperdx" Keycloak client (rotate like grafana's).
HYPERDX_OAUTH_SECRET=CHANGE_ME_HYPERDX_CLIENT_SECRET
# MongoDB root password for HyperDX app state (users/dashboards/searches).
HYPERDX_DB_PASSWORD=CHANGE_ME
# oauth2-proxy cookie encryption secret: MUST be 16/24/32 bytes (openssl rand -hex 16).
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME_32_CHARS

# --- Phase 3: host + K8s ingestion (vector-hosts, always on) ---
# Shared HEC token K8s clusters use to push to :8088 (openssl rand -base64 24).
SPLUNK_HEC_TOKEN=CHANGE_ME

# --- Phase 2: AWS ingestion (Vector) ---
# The vector service is behind the "aws" compose profile. Once the values below
# are real (see docs/aws-ingestion.md for the AWS-side setup + IAM policy),
# uncomment COMPOSE_PROFILES and `docker compose up -d`.
#COMPOSE_PROFILES=aws
AWS_REGION=us-east-1
# Dedicated ingest IAM user (sqs receive/delete + s3 get only — policy in docs/aws-ingestion.md)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# One queue per log family (aws_s3 source cannot demux object types)
SQS_URL_CLOUDTRAIL=
SQS_URL_GUARDDUTY=
SQS_URL_VPCFLOW=
SQS_URL_S3ACCESS=
