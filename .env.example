# Copy to .env and fill in real values. NEVER commit .env to git (.gitignore already excludes it).
# Generate strong values, e.g.:  openssl rand -base64 24

# --- Local container runtime ---
# Podman is default. Set this to docker for an existing Docker deployment.
# Fresh bootstrap: IRONLOG_CONTAINER_RUNTIME=docker ./bootstrap.sh
# Bootstrap refuses an existing .env; manual setup uses scripts/compose.sh.
IRONLOG_CONTAINER_RUNTIME=podman

# --- ClickHouse ---
CH_ADMIN_USER=siem_admin
CH_ADMIN_PASSWORD=CHANGE_ME
CH_VECTOR_PASSWORD=CHANGE_ME
CH_GRAFANA_ANALYST_PASSWORD=CHANGE_ME
CH_GRAFANA_AUDITOR_PASSWORD=CHANGE_ME
CH_HYPERDX_PASSWORD=CHANGE_ME

# --- Grafana ---
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=IronlogDev123!

# --- HyperDX (search UI; native local authentication on :8081) ---
HYPERDX_PUBLIC_URL=http://localhost:8081
HYPERDX_LOCAL_EMAIL=admin@ironlog.local
HYPERDX_LOCAL_PASSWORD=IronlogDev123!
# MongoDB root password for HyperDX app state (users/dashboards/searches).
HYPERDX_DB_PASSWORD=CHANGE_ME
# Native session signing secret; generated by bootstrap (openssl rand -hex 32).
HYPERDX_SESSION_SECRET=CHANGE_ME

# --- Phase 3: host + K8s ingestion (vector-hosts, always on) ---
# Shared HEC token K8s clusters use to push to :8088 (openssl rand -base64 24).
SPLUNK_HEC_TOKEN=CHANGE_ME

# --- Phase 2: AWS ingestion (Vector) ---
# The vector service is behind the "aws" compose profile. Once the values below
# are real (see docs/aws-ingestion.md for the AWS-side setup + IAM policy),
# uncomment COMPOSE_PROFILES and `scripts/compose.sh up -d`.
#COMPOSE_PROFILES=aws
AWS_REGION=us-east-1
# Dedicated ingest IAM user (sqs receive/delete + s3 get only â€” policy in docs/aws-ingestion.md)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# One queue per log family (aws_s3 source cannot demux object types)
SQS_URL_CLOUDTRAIL=
SQS_URL_GUARDDUTY=
SQS_URL_VPCFLOW=
SQS_URL_S3ACCESS=
