digraph ironlog_ingestion {
 subgraph cluster_sources {
  kind=zone; label="01  SOURCES";
  windows [kind=desktop label="Windows agent" color="#7C3AED" notes="Purple: source. Vector reads Windows Security, System and PowerShell Operational events."];
  linux [kind=server label="Linux agent" color="#7C3AED" notes="Purple: source. Vector reads journald and auditd files."];
  k8s [kind=container-host label="Kubernetes shipper" color="#7C3AED" notes="Purple: source. Vector DaemonSet ships pod logs using token-authenticated HEC."];
  aws [kind=cloud-storage label="S3 + SQS (optional)" color="#7C3AED" notes="Purple: optional AWS source. CloudTrail, GuardDuty, VPC Flow and S3 access; SQS references S3 objects. Not an on-prem dependency."];
 }
 subgraph cluster_ingestion {
  kind=zone; label="02  INGESTION";
  hosts [kind=container label="Vector Hosts 0.61.0" color="#0D9488" notes="Teal: always-on collector. Native TCP 6000; HEC 8088. VRL normalization; per-sink disk buffers."];
  awsCollector [kind=container label="Vector AWS 0.61.0 (optional)" color="#0D9488" notes="Teal: optional AWS collector. Reads SQS notifications and fetches S3 objects; VRL transforms and disk buffers."];
 }
 subgraph cluster_database {
  kind=zone; label="03  EVENT STORAGE";
  ch [kind=database label="ClickHouse 26.8" color="#2563EB" notes="Blue: event storage. ClickHouse 26.8.34.13 LTS. Seven typed tables: cloudtrail, guardduty, vpc_flow, s3_access, windows_events, linux_syslog, k8s_logs (text index on message for the last three). INSERT-only svc_vector. Current table retention: 30 days; selected raw fields: 7 days."];
 }
 windows -> hosts [label="Native TCP 6000"];
 linux -> hosts [label="Native TCP 6000"];
 k8s -> hosts [label="HEC 8088 + token"];
 aws -> awsCollector [label="Notifications + objects"];
 hosts -> ch [label="svc_vector / INSERT"];
 awsCollector -> ch [label="svc_vector / INSERT"];
}