digraph ironlog_concepts {
  label="Ironlog | Conceptual architecture - what each part does, not which product does it";
  subgraph cluster_sources {
    kind=zone; label="01  SOURCES - systems that emit security events";
    agents [kind=managed-endpoint label="Host log agents [AU-12]\nRole: edge collector on each server or workstation;\nreads OS logs, buffers on disk, forwards them" color="#7C3AED" notes="Purple: event source. Implementation today: Vector agents. vector/agent-windows.yaml reads the Security, System and PowerShell/Operational event logs; vector/agent-linux.yaml reads journald and auditd. Installed by scripts/install-windows-agent.ps1 and docs/host-ingestion.md."];
    shipper [kind=container-host label="Cluster log shipper [AU-12]\nRole: per-node daemon forwards every container's\nlogs over an authenticated HTTP event API" color="#7C3AED" notes="Purple: event source. Implementation today: Vector DaemonSet k8s/vector-shipper.yaml sending Splunk HEC on 8088 with a token. The local k3s demo is an optional test producer."];
    cloud [kind=cloud-storage label="Cloud audit logs - OPTIONAL [AU-12]\nRole: control-plane, threat, network-flow and access\nlogs in object storage; a queue announces each object" color="#7C3AED" notes="Purple: optional event source. Implementation today: AWS CloudTrail, GuardDuty, VPC Flow Logs and S3 server access logs in S3, one SQS queue per log type. docs/aws-ingestion.md."];
  }
  subgraph cluster_etl {
    kind=zone; label="02  STREAMING ETL - extract, transform, buffer, load";
    push [kind=container label="Push pipeline - always on [AU-3]\nRole: receive agent and HTTP events, route by source,\nnormalise to typed rows, disk-buffer, batch-load" color="#0D9488" notes="Teal: ingestion. Implementation today: Vector 0.61.0 in the ironlog-vector image with IRONLOG_VECTOR_ROLE=hosts (vector/hosts.yaml): vector source on 6000, splunk_hec source on 8088, VRL remap transforms, 2 GiB disk buffers that block when full, ClickHouse sinks."];
    pull [kind=container label="Pull pipeline - OPTIONAL [AU-3]\nRole: consume the notification queue, fetch objects,\nnormalise to typed rows, disk-buffer, batch-load" color="#0D9488" notes="Teal: optional ingestion. Implementation today: Vector 0.61.0 with IRONLOG_VECTOR_ROLE=aws (vector/vector.yaml): aws_s3 sources fed by SQS, VRL remap transforms, disk buffers, ClickHouse sinks. Off by default: Compose profile aws, Quadlet ships disabled, Helm vector.aws.enabled."];
  }
  subgraph cluster_olap {
    kind=zone; label="03  COLUMNAR OLAP DATABASE - event store, SQL, RBAC";
    hot [kind=database label="Event tables - hot tier [AU-11]\nRole: one typed columnar table per source; bloom-filter\nand full-text indexes; age-based deletion (TTL)" color="#2563EB" notes="Blue: data. Implementation today: ClickHouse 26.8.34.13 LTS MergeTree tables in the siem database (clickhouse/ddl/010_aws.sql, 020_hosts.sql). Text index idx_msg_text on windows_events, linux_syslog and k8s_logs; siem.log_search view in 050_search.sql. Retention is 30 days with the cold tier off, 400 with it on (images/README.md)."];
    cold [kind=cloud-storage label="Cold tier - OPTIONAL [AU-4]\nRole: tiered storage moves older data parts\nto S3-compatible object storage" color="#2563EB" notes="Blue: optional data tier. Implementation today: ClickHouse S3 disk and storage policy, switched on by IRONLOG_S3_TIER=on with IRONLOG_HOT_DAYS; the image generates config.d/20-storage-s3.xml at start. Live-tested 2026-11-04 against an S3-compatible store; real AWS S3 untested; switching back off is unsupported."];
    audit [kind=database label="Query audit trail - 2-year TTL [AU-9]\nRole: a materialized view copies every finished\nquery from the database's own query log" color="#2563EB" notes="Blue: data. Implementation today: audit.query_archive filled by query_archive_mv from system.query_log (clickhouse/ddl/030_audit.sql). Attribution is to the shared service identities, not to individual UI users."];
    idents [kind=user label="Least-privilege identities [AC-6, AU-9]\nRole: database RBAC - the pipeline may only write;\nanalyst and auditor identities may only read" color="#2563EB" notes="Blue: access control. Implementation today: ClickHouse roles siem_ingest (svc_vector), siem_analyst (svc_grafana_analyst) and siem_auditor (svc_grafana_auditor), profile siem_reader (clickhouse/ddl/040_rbac.sql)."];
  }
  subgraph cluster_apps {
    kind=zone; label="04  APPLICATIONS - visualisation, alerting, schema control";
    ui [kind=siem label="Visualisation and alerting UI [AU-5, AU-6]\nRole: dashboards, free-text search, ad-hoc SQL and\nper-source silence alerts; the only UI" color="#D97706" notes="Amber: application. Implementation today: Grafana OSS 13.3.0 with ClickHouse plugin 4.23.4 (ironlog-grafana image) on port 3000; Log Search dashboard over siem.log_search; seven AU-5 ingestion-silence alert rules; analyst and auditor datasources."];
    schema [kind=container label="Schema migration job - one-shot [AU-9]\nRole: applies tables, identities and retention,\nverifies them, then lets the other services start" color="#D97706" notes="Amber: one-shot job. Implementation today: the ironlog-schema command of the ironlog-clickhouse image (Quadlet ironlog-schema.service, Compose service schema, Helm post-install/upgrade hook Job)."];
  }
  subgraph cluster_people {
    kind=zone; label="05  PEOPLE";
    users [kind=user-group label="Analysts and auditors\nRole: sign in to the UI with a local account;\nno single sign-on or MFA today" color="#7C3AED" notes="Purple: people. docs/local-auth.md."];
  }
  subgraph cluster_packaging {
    kind=zone; label="06  PACKAGING - one immutable container image per concept, configuration baked in, published by CI with an SBOM";
    imgetl [kind=container label="Pipeline image\nRole: one image, two roles (push or pull),\nchosen by an environment variable" color="#475569" notes="Slate: image. Implementation today: ironlog-vector:0.61.0 (images/vector/Dockerfile), IRONLOG_VECTOR_ROLE=hosts or aws."];
    imgdb [kind=container label="Database image\nRole: OLAP server plus the schema job;\ntables, config and cold-tier switch baked in" color="#475569" notes="Slate: image. Implementation today: ironlog-clickhouse:26.8.34.13 (images/clickhouse/Dockerfile)."];
    imgui [kind=container label="UI image\nRole: visualisation server, database connector,\ndashboards and alert rules baked in" color="#475569" notes="Slate: image. Implementation today: ironlog-grafana:13.3.0 with ClickHouse plugin 4.23.4 (images/grafana/Dockerfile)."];
  }
  subgraph cluster_runtimes {
    kind=zone; label="07  RUNTIMES - the same three images on interchangeable orchestrators";
    rhost [kind=server label="Host service manager [VERIFIED]\nRole: containers run as system services on one\nhost, or split with the database on its own host" color="#475569" notes="Slate: runtime. Implementation today: podman Quadlets on Oracle Linux 9 (quadlets/), live-tested 2026-11-04 single host and two-host split with SELinux enforcing."];
    rdev [kind=server label="Developer compose stack\nRole: builds the images locally and runs\nthe whole stack on one workstation" color="#475569" notes="Slate: runtime. Implementation today: docker-compose.yml through scripts/compose.sh; podman by default, Docker selectable."];
    rk8s [kind=container-host label="Kubernetes package\nRole: stateful database plus schema hook job;\nCI installs it under restricted Pod Security" color="#475569" notes="Slate: runtime. Implementation today: Helm chart deploy/helm/ironlog, CI on kind (.github/workflows/helm.yml); OpenShift SCC and Routes are not exercised by CI."];
    rcloud [kind=cloud-compute label="Managed container service - PLANNED\nRole: not built yet; named as a wave-2\ntarget in the image contract" color="#9CA3AF" notes="Grey: planned, not implemented. Amazon ECS on EC2 per images/README.md; deploy/ecs/ does not exist yet."];
    rvm [kind=vm label="VM image appliance - LEGACY\nRole: hardened OS image with the stack baked in;\npredates the portable container images" color="#9CA3AF" notes="Grey: legacy, still in the repository. Packer EC2 AMI (packer/, scripts/build-ami.sh), RHEL 9 shipping and Rocky 9 development."];
  }
  subgraph cluster_legend {
    kind=zone; label="LEGEND - colours, lines and tags";
    l1 [kind=server label="Purple\nevent sources and people" color="#7C3AED" notes="Legend."];
    l2 [kind=container label="Teal\nstreaming ETL" color="#0D9488" notes="Legend."];
    l3 [kind=database label="Blue\nOLAP database, tiers, identities" color="#2563EB" notes="Legend."];
    l4 [kind=container label="Amber\napplications and jobs" color="#D97706" notes="Legend."];
    l5 [kind=container label="Slate\npackaging and runtimes" color="#475569" notes="Legend."];
    l6 [kind=cloud-storage label="Grey\nPLANNED or LEGACY, not current" color="#9CA3AF" notes="Legend."];
    l7 [kind=router label="Lines and tags\nBoxes name concepts, not products (box notes name today's implementation); no arrowheads; OPTIONAL = set by config\n[AU-n] = NIST 800-53 control per docs/control-mapping.md" color="#4B5563" notes="Legend."];
  }
  agents -> push [label="push: agent protocol"];
  shipper -> push [label="push: HTTP event API + token"];
  cloud -> pull [label="OPTIONAL: queue notice, object fetch"];
  push -> hot [label="batch INSERT, write-only"];
  pull -> hot [label="batch INSERT, write-only"];
  hot -> cold [label="OPTIONAL: move parts by age"];
  ui -> hot [label="read-only SQL"];
  ui -> audit [label="read-only SQL (auditor)"];
  users -> ui [label="browser"];
  schema -> hot [label="DDL, identities, TTLs"];
}
