<mxfile host="Drawbridge"><diagram id="page-1" name="ironlog_concepts"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="01  SOURCES - systems that emit security events" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fillColor=none;strokeColor=#8E9AA6;fontColor=#5D6D7E;drawbridge=zone;strokeColor=#7C3AED;drawbridge-color=#7C3AED;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="440" height="1130" as="geometry"/></mxCell><mxCell id="n2" value="02  STREAMING ETL - extract, transform, buffer, load" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fillColor=none;strokeColor=#8E9AA6;fontColor=#5D6D7E;drawbridge=zone;strokeColor=#0D9488;drawbridge-color=#0D9488;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="440" height="1130" as="geometry"/></mxCell><mxCell id="n3" value="03  COLUMNAR OLAP DATABASE - event store, SQL, RBAC" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fillColor=none;strokeColor=#8E9AA6;fontColor=#5D6D7E;drawbridge=zone;strokeColor=#2563EB;drawbridge-color=#2563EB;" vertex="1" parent="1"><mxGeometry x="1240" y="80" width="440" height="1130" as="geometry"/></mxCell><mxCell id="n4" value="04  APPLICATIONS - visualisation, alerting, schema control" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fillColor=none;strokeColor=#8E9AA6;fontColor=#5D6D7E;drawbridge=zone;strokeColor=#D97706;drawbridge-color=#D97706;" vertex="1" parent="1"><mxGeometry x="1840" y="80" width="440" height="1130" as="geometry"/></mxCell><mxCell id="n5" value="05  PEOPLE" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fillColor=none;strokeColor=#8E9AA6;fontColor=#5D6D7E;drawbridge=zone;strokeColor=#7C3AED;drawbridge-color=#7C3AED;" vertex="1" parent="1"><mxGeometry x="2440" y="80" width="440" height="1130" as="geometry"/></mxCell><mxCell id="n6" value="06  PACKAGING - one immutable container image per concept, configuration baked in, published by CI with an SBOM" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fillColor=none;strokeColor=#8E9AA6;fontColor=#5D6D7E;drawbridge=zone;strokeColor=#475569;drawbridge-color=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="1260" width="2840" height="280" as="geometry"/></mxCell><mxCell id="n7" value="07  RUNTIMES - the same three images on interchangeable orchestrators" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fillColor=none;strokeColor=#8E9AA6;fontColor=#5D6D7E;drawbridge=zone;strokeColor=#475569;drawbridge-color=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="1590" width="2840" height="280" as="geometry"/></mxCell><mxCell id="n8" value="LEGEND - colours, lines and tags" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;fillColor=none;strokeColor=#8E9AA6;fontColor=#5D6D7E;drawbridge=zone;strokeColor=#6B7280;drawbridge-color=#6B7280;" vertex="1" parent="1"><mxGeometry x="40" y="1920" width="2840" height="260" as="geometry"/></mxCell><mxCell id="e1" value="push: agent protocol" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=none;strokeColor=#5D6D7E;drawbridge-edge=1;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="push: HTTP event API + token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=none;strokeColor=#5D6D7E;drawbridge-edge=1;" edge="1" parent="1" source="n10" target="n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="645"/><mxPoint x="560" y="429"/></Array></mxGeometry></mxCell><mxCell id="e3" value="OPTIONAL: queue notice, object fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=none;strokeColor=#5D6D7E;drawbridge-edge=1;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="batch INSERT, write-only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=none;strokeColor=#5D6D7E;drawbridge-edge=1;" edge="1" parent="1" source="n12" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="225"/></Array></mxGeometry></mxCell><mxCell id="e5" value="batch INSERT, write-only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=none;strokeColor=#5D6D7E;drawbridge-edge=1;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="977.0079920079921"/><mxPoint x="1160" y="335"/><mxPoint x="1456" y="335"/></Array></mxGeometry></mxCell><mxCell id="e6" value="OPTIONAL: move parts by age" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=none;strokeColor=#5D6D7E;drawbridge-edge=1;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="read-only SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=none;strokeColor=#5D6D7E;drawbridge-edge=1;" edge="1" parent="1" source="n18" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1762.6666666666663" y="421"/><mxPoint x="1762.6666666666663" y="221"/></Array></mxGeometry></mxCell><mxCell id="e8" value="read-only SQL (auditor)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=none;strokeColor=#5D6D7E;drawbridge-edge=1;" edge="1" parent="1" source="n18" target="n16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1762.6666666666663" y="429"/><mxPoint x="1762.6666666666663" y="665"/></Array></mxGeometry></mxCell><mxCell id="e9" value="browser" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=none;strokeColor=#5D6D7E;drawbridge-edge=1;" edge="1" parent="1" source="n20" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="DDL, identities, TTLs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=none;strokeColor=#5D6D7E;drawbridge-edge=1;" edge="1" parent="1" source="n19" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1754.6666666666663" y="825"/><mxPoint x="1754.6666666666663" y="229"/></Array></mxGeometry></mxCell><object id="n9" label="Host log agents [AU-12]&lt;br&gt;Role: edge collector on each server or workstation;&lt;br&gt;reads OS logs, buffers on disk, forwards them" notes="Purple: event source. Implementation today: Vector agents. vector/agent-windows.yaml reads the Security, System and PowerShell/Operational event logs; vector/agent-linux.yaml reads journald and auditd. Installed by scripts/install-windows-agent.ps1 and docs/host-ingestion.md."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEE5;strokeColor=#A0722A;fontColor=#583F17;drawbridge=managed-endpoint;strokeColor=#7C3AED;drawbridge-color=#7C3AED;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="50" y="340" width="420" height="170" as="geometry"/></mxCell></object><mxCell id="n9.icon" style="shape=image;imageAspect=0;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%20fill%3D%22none%22%20stroke%3D%22%237C3AED%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%2212%22%20y%3D%229%22%20width%3D%2224%22%20height%3D%2216%22%20rx%3D%222.5%22%2F%3E%3Cpath%20d%3D%22M12%2025l-3%207M36%2025l3%207%22%2F%3E%3Cpath%20d%3D%22M7%2032h34%22%2F%3E%3Cpath%20d%3D%22M24%2011.5l4.3%201.45v3c0%202.9-1.9%204.8-4.3%205.7-2.4-.9-4.3-2.8-4.3-5.7v-3z%22%2F%3E%3Cpath%20d%3D%22M21.9%2016.2l1.6%201.6%202.9-3.2%22%2F%3E%3C%2Fsvg%3E;drawbridge=tileicon;" vertex="1" connectable="0" parent="n9"><mxGeometry x="158.34" y="11.34" width="103.32" height="103.32" as="geometry"/></mxCell><object id="n10" label="Cluster log shipper [AU-12]&lt;br&gt;Role: per-node daemon forwards every container's&lt;br&gt;logs over an authenticated HTTP event API" notes="Purple: event source. Implementation today: Vector DaemonSet k8s/vector-shipper.yaml sending Splunk HEC on 8088 with a token. The local k3s demo is an optional test producer."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0EC;strokeColor=#2E8564;fontColor=#194937;drawbridge=container-host;strokeColor=#7C3AED;drawbridge-color=#7C3AED;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="420" height="170" as="geometry"/></mxCell></object><mxCell id="n10.icon" style="shape=image;imageAspect=0;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%20fill%3D%22none%22%20stroke%3D%22%237C3AED%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%227%22%20y%3D%229%22%20width%3D%2234%22%20height%3D%2230%22%20rx%3D%223%22%2F%3E%3Cpath%20d%3D%22M7%2016h34%22%2F%3E%3Ccircle%20cx%3D%2211%22%20cy%3D%2212.5%22%20r%3D%221.1%22%20fill%3D%22%237C3AED%22%20stroke%3D%22none%22%2F%3E%3Cpath%20d%3D%22M15%2012.5h6%22%2F%3E%3Crect%20x%3D%2211%22%20y%3D%2221%22%20width%3D%227.5%22%20height%3D%2212%22%20rx%3D%221.5%22%2F%3E%3Crect%20x%3D%2220.25%22%20y%3D%2221%22%20width%3D%227.5%22%20height%3D%2212%22%20rx%3D%221.5%22%2F%3E%3Crect%20x%3D%2229.5%22%20y%3D%2221%22%20width%3D%227.5%22%20height%3D%2212%22%20rx%3D%221.5%22%2F%3E%3C%2Fsvg%3E;drawbridge=tileicon;" vertex="1" connectable="0" parent="n10"><mxGeometry x="158.34" y="11.34" width="103.32" height="103.32" as="geometry"/></mxCell><object id="n11" label="Cloud audit logs - OPTIONAL [AU-12]&lt;br&gt;Role: control-plane, threat, network-flow and access&lt;br&gt;logs in object storage; a queue announces each object" notes="Purple: optional event source. Implementation today: AWS CloudTrail, GuardDuty, VPC Flow Logs and S3 server access logs in S3, one SQS queue per log type. docs/aws-ingestion.md."><mxCell style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#E6F2F5;strokeColor=#2B8FA8;fontColor=#184F5C;drawbridge=cloud-storage;strokeColor=#7C3AED;drawbridge-color=#7C3AED;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="50" y="900" width="420" height="170" as="geometry"/></mxCell></object><mxCell id="n11.icon" style="shape=image;imageAspect=0;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%20fill%3D%22none%22%20stroke%3D%22%237C3AED%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M17%2021a4.5%204.5%200%200%201%200-9%207%207%200%200%201%2014-.02A4.5%204.5%200%200%201%2031%2021Z%22%2F%3E%3Cellipse%20cx%3D%2224%22%20cy%3D%2227%22%20rx%3D%227%22%20ry%3D%222.5%22%2F%3E%3Cpath%20d%3D%22M17%2027v9a7%202.5%200%200%200%2014%200v-9%22%2F%3E%3C%2Fsvg%3E;drawbridge=tileicon;" vertex="1" connectable="0" parent="n11"><mxGeometry x="158.34" y="11.34" width="103.32" height="103.32" as="geometry"/></mxCell><object id="n12" label="Push pipeline - always on [AU-3]&lt;br&gt;Role: receive agent and HTTP events, route by source,&lt;br&gt;normalise to typed rows, disk-buffer, batch-load" notes="Teal: ingestion. Implementation today: Vector 0.61.0 in the ironlog-vector image with IRONLOG_VECTOR_ROLE=hosts (vector/hosts.yaml): vector source on 6000, splunk_hec source on 8088, VRL remap transforms, 2 GiB disk buffers that block when full, ClickHouse sinks."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0EC;strokeColor=#2E8564;fontColor=#194937;drawbridge=container;strokeColor=#0D9488;drawbridge-color=#0D9488;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="650" y="340" width="420" height="170" as="geometry"/></mxCell></object><mxCell id="n12.icon" style="shape=image;imageAspect=0;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%2217%22%20y%3D%2212%22%20width%3D%2214%22%20height%3D%2212%22%20rx%3D%222%22%2F%3E%3Crect%20x%3D%229%22%20y%3D%2227%22%20width%3D%2214%22%20height%3D%2212%22%20rx%3D%222%22%2F%3E%3Crect%20x%3D%2225%22%20y%3D%2227%22%20width%3D%2214%22%20height%3D%2212%22%20rx%3D%222%22%2F%3E%3C%2Fsvg%3E;drawbridge=tileicon;" vertex="1" connectable="0" parent="n12"><mxGeometry x="158.34" y="11.34" width="103.32" height="103.32" as="geometry"/></mxCell><object id="n13" label="Pull pipeline - OPTIONAL [AU-3]&lt;br&gt;Role: consume the notification queue, fetch objects,&lt;br&gt;normalise to typed rows, disk-buffer, batch-load" notes="Teal: optional ingestion. Implementation today: Vector 0.61.0 with IRONLOG_VECTOR_ROLE=aws (vector/vector.yaml): aws_s3 sources fed by SQS, VRL remap transforms, disk buffers, ClickHouse sinks. Off by default: Compose profile aws, Quadlet ships disabled, Helm vector.aws.enabled."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0EC;strokeColor=#2E8564;fontColor=#194937;drawbridge=container;strokeColor=#0D9488;drawbridge-color=#0D9488;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="650" y="900" width="420" height="170" as="geometry"/></mxCell></object><mxCell id="n13.icon" style="shape=image;imageAspect=0;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%20fill%3D%22none%22%20stroke%3D%22%230D9488%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%2217%22%20y%3D%2212%22%20width%3D%2214%22%20height%3D%2212%22%20rx%3D%222%22%2F%3E%3Crect%20x%3D%229%22%20y%3D%2227%22%20width%3D%2214%22%20height%3D%2212%22%20rx%3D%222%22%2F%3E%3Crect%20x%3D%2225%22%20y%3D%2227%22%20width%3D%2214%22%20height%3D%2212%22%20rx%3D%222%22%2F%3E%3C%2Fsvg%3E;drawbridge=tileicon;" vertex="1" connectable="0" parent="n13"><mxGeometry x="158.34" y="11.34" width="103.32" height="103.32" as="geometry"/></mxCell><object id="n14" label="Event tables - hot tier [AU-11]&lt;br&gt;Role: one typed columnar table per source; bloom-filter&lt;br&gt;and full-text indexes; age-based deletion (TTL)" notes="Blue: data. Implementation today: ClickHouse 26.8.34.13 LTS MergeTree tables in the siem database (clickhouse/ddl/010_aws.sql, 020_hosts.sql). Text index idx_msg_text on windows_events, linux_syslog and k8s_logs; siem.log_search view in 050_search.sql. Retention is 30 days with the cold tier off, 400 with it on (images/README.md)."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEBF7;strokeColor=#7458BE;fontColor=#403069;drawbridge=database;strokeColor=#2563EB;drawbridge-color=#2563EB;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1250" y="140" width="420" height="170" as="geometry"/></mxCell></object><mxCell id="n14.icon" style="shape=image;imageAspect=0;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%20fill%3D%22none%22%20stroke%3D%22%232563EB%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cellipse%20cx%3D%2224%22%20cy%3D%2211%22%20rx%3D%2214%22%20ry%3D%225%22%2F%3E%3Cpath%20d%3D%22M10%2011v26%22%2F%3E%3Cpath%20d%3D%22M38%2011v26%22%2F%3E%3Cpath%20d%3D%22M10%2037a14%205%200%200%200%2028%200%22%2F%3E%3Cpath%20d%3D%22M10%2024a14%205%200%200%200%2028%200%22%2F%3E%3C%2Fsvg%3E;drawbridge=tileicon;" vertex="1" connectable="0" parent="n14"><mxGeometry x="158.34" y="11.34" width="103.32" height="103.32" as="geometry"/></mxCell><object id="n15" label="Cold tier - OPTIONAL [AU-4]&lt;br&gt;Role: tiered storage moves older data parts&lt;br&gt;to S3-compatible object storage" notes="Blue: optional data tier. Implementation today: ClickHouse S3 disk and storage policy, switched on by IRONLOG_S3_TIER=on with IRONLOG_HOT_DAYS; the image generates config.d/20-storage-s3.xml at start. Live-tested 2026-11-04 against an S3-compatible store; real AWS S3 untested; switching back off is unsupported."><mxCell style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#E6F2F5;strokeColor=#2B8FA8;fontColor=#184F5C;drawbridge=cloud-storage;strokeColor=#2563EB;drawbridge-color=#2563EB;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1250" y="360" width="420" height="170" as="geometry"/></mxCell></object><mxCell id="n15.icon" style="shape=image;imageAspect=0;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%20fill%3D%22none%22%20stroke%3D%22%232563EB%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M17%2021a4.5%204.5%200%200%201%200-9%207%207%200%200%201%2014-.02A4.5%204.5%200%200%201%2031%2021Z%22%2F%3E%3Cellipse%20cx%3D%2224%22%20cy%3D%2227%22%20rx%3D%227%22%20ry%3D%222.5%22%2F%3E%3Cpath%20d%3D%22M17%2027v9a7%202.5%200%200%200%2014%200v-9%22%2F%3E%3C%2Fsvg%3E;drawbridge=tileicon;" vertex="1" connectable="0" parent="n15"><mxGeometry x="158.34" y="11.34" width="103.32" height="103.32" as="geometry"/></mxCell><object id="n16" label="Query audit trail - 2-year TTL [AU-9]&lt;br&gt;Role: a materialized view copies every finished&lt;br&gt;query from the database's own query log" notes="Blue: data. Implementation today: audit.query_archive filled by query_archive_mv from system.query_log (clickhouse/ddl/030_audit.sql). Attribution is to the shared service identities, not to individual UI users."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEBF7;strokeColor=#7458BE;fontColor=#403069;drawbridge=database;strokeColor=#2563EB;drawbridge-color=#2563EB;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1250" y="580" width="420" height="170" as="geometry"/></mxCell></object><mxCell id="n16.icon" style="shape=image;imageAspect=0;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%20fill%3D%22none%22%20stroke%3D%22%232563EB%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cellipse%20cx%3D%2224%22%20cy%3D%2211%22%20rx%3D%2214%22%20ry%3D%225%22%2F%3E%3Cpath%20d%3D%22M10%2011v26%22%2F%3E%3Cpath%20d%3D%22M38%2011v26%22%2F%3E%3Cpath%20d%3D%22M10%2037a14%205%200%200%200%2028%200%22%2F%3E%3Cpath%20d%3D%22M10%2024a14%205%200%200%200%2028%200%22%2F%3E%3C%2Fsvg%3E;drawbridge=tileicon;" vertex="1" connectable="0" parent="n16"><mxGeometry x="158.34" y="11.34" width="103.32" height="103.32" as="geometry"/></mxCell><object id="n17" label="Least-privilege identities [AC-6, AU-9]&lt;br&gt;Role: database RBAC - the pipeline may only write;&lt;br&gt;analyst and auditor identities may only read" notes="Blue: access control. Implementation today: ClickHouse roles siem_ingest (svc_vector), siem_analyst (svc_grafana_analyst) and siem_auditor (svc_grafana_auditor), profile siem_reader (clickhouse/ddl/040_rbac.sql)."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEE5;strokeColor=#A0722A;fontColor=#583F17;drawbridge=user;strokeColor=#2563EB;drawbridge-color=#2563EB;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1250" y="900" width="420" height="170" as="geometry"/></mxCell></object><mxCell id="n17.icon" style="shape=image;imageAspect=0;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%20fill%3D%22none%22%20stroke%3D%22%232563EB%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2224%22%20cy%3D%2216%22%20r%3D%227%22%2F%3E%3Cpath%20d%3D%22M10%2040a14%2012%200%200%201%2028%200%22%2F%3E%3C%2Fsvg%3E;drawbridge=tileicon;" vertex="1" connectable="0" parent="n17"><mxGeometry x="158.34" y="11.34" width="103.32" height="103.32" as="geometry"/></mxCell><object id="n18" label="Visualisation and alerting UI [AU-5, AU-6]&lt;br&gt;Role: dashboards, free-text search, ad-hoc SQL and&lt;br&gt;per-source silence alerts; the only UI" notes="Amber: application. Implementation today: Grafana OSS 13.3.0 with ClickHouse plugin 4.23.4 (ironlog-grafana image) on port 3000; Log Search dashboard over siem.log_search; seven AU-5 ingestion-silence alert rules; analyst and auditor datasources."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6E9E8;strokeColor=#B4453F;fontColor=#632623;drawbridge=siem;strokeColor=#D97706;drawbridge-color=#D97706;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1850" y="340" width="420" height="170" as="geometry"/></mxCell></object><mxCell id="n18.icon" style="shape=image;imageAspect=0;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%20fill%3D%22none%22%20stroke%3D%22%23D97706%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%2210%22%20y%3D%228%22%20width%3D%2220%22%20height%3D%2228%22%20rx%3D%222%22%2F%3E%3Cpath%20d%3D%22M14%2015h12M14%2020h12M14%2025h8%22%2F%3E%3Ccircle%20cx%3D%2231%22%20cy%3D%2230%22%20r%3D%226%22%2F%3E%3Cpath%20d%3D%22M35.5%2034.5l4%204%22%2F%3E%3C%2Fsvg%3E;drawbridge=tileicon;" vertex="1" connectable="0" parent="n18"><mxGeometry x="158.34" y="11.34" width="103.32" height="103.32" as="geometry"/></mxCell><object id="n19" label="Schema migration job - one-shot [AU-9]&lt;br&gt;Role: applies tables, identities and retention,&lt;br&gt;verifies them, then lets the other services start" notes="Amber: one-shot job. Implementation today: the ironlog-schema command of the ironlog-clickhouse image (Quadlet ironlog-schema.service, Compose service schema, Helm post-install/upgrade hook Job)."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F0EC;strokeColor=#2E8564;fontColor=#194937;drawbridge=container;strokeColor=#D97706;drawbridge-color=#D97706;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1850" y="740" width="420" height="170" as="geometry"/></mxCell></object><mxCell id="n19.icon" style="shape=image;imageAspect=0;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%20fill%3D%22none%22%20stroke%3D%22%23D97706%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Crect%20x%3D%2217%22%20y%3D%2212%22%20width%3D%2214%22%20height%3D%2212%22%20rx%3D%222%22%2F%3E%3Crect%20x%3D%229%22%20y%3D%2227%22%20width%3D%2214%22%20height%3D%2212%22%20rx%3D%222%22%2F%3E%3Crect%20x%3D%2225%22%20y%3D%2227%22%20width%3D%2214%22%20height%3D%2212%22%20rx%3D%222%22%2F%3E%3C%2Fsvg%3E;drawbridge=tileicon;" vertex="1" connectable="0" parent="n19"><mxGeometry x="158.34" y="11.34" width="103.32" height="103.32" as="geometry"/></mxCell><object id="n20" label="Analysts and auditors&lt;br&gt;Role: sign in to the UI with a local account;&lt;br&gt;no single sign-on or MFA today" notes="Purple: people. docs/local-auth.md."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4EEE5;strokeColor=#A0722A;fontColor=#583F17;drawbridge=user-group;strokeColor=#7C3AED;drawbridge-color=#7C3AED;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="2450" y="340" width="420" height="170" as="geometry"/></mxCell></object><mxCell id="n20.icon" style="shape=image;imageAspect=0;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2