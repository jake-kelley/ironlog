+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%20fill%3D%22none%22%20stroke%3D%22%232563EB%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2224%22%20cy%3D%2216%22%20r%3D%227%22%2F%3E%3Cpath%20d%3D%22M10%2040a14%2012%200%200%201%2028%200%22%2F%3E%3C%2Fsvg%3E;drawbridge=tileicon;" vertex="1" connectable="0" parent="n18"><mxGeometry x="158.34" y="11.34" width="103.32" height="103.32" as="geometry"/></mxCell><object id="n19" label="S3 cold tier - OPTIONAL [AU-4]&lt;br&gt;Role: IRONLOG_S3_TIER=on (default off) moves parts&lt;br&gt;older than IRONLOG_HOT_DAYS to AWS S3 or S3-compatible" notes="Blue: optional data tier. Enabled by environment on the ironlog-clickhouse image, which generates config.d/20-storage-s3.xml at start. Live-tested 2026-11-04 on Oracle Linux 9 against a SeaweedFS S3-compatible store (quadlets/README.md); real AWS S3 not tested. Switching back off is unsupported."><mxCell style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#E6F2F5;strokeColor=#2B8FA8;fontColor=#184F5C;drawbridge=cloud-storage;strokeColor=#2563EB;drawbridge-color=#2563EB;verticalAlign=bottom;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1250" y="360" width="420" height="170" as="geometry"/></mxCell></object><mxCell id="n19.icon" style="shape=image;imageAspect=0;image=data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2048%2048%22%20fill%3D%22none%22%20stroke%3D%22%232563EB%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M17%2021a4.5%204.5%200%200%201%200-9%207%207%200%200%201%2014-.02A4.5%204.5%200%200%201%2031%2021Z%22%2F%3E%3Cellipse%20cx%3D%2224%22%20cy%3D%2227%22%20rx%3D%227%22%20ry%3D%222.5%22%2F%3E%3Cpath%20d%3D%22M17%2027v9a7%202.5%200%200%200%2014%200v-9%22%2F%3E%3C%2Fsvg%3E;drawbridge=tileicon;" vertex="1" connectable="0" parent="n19"><mxGeometr