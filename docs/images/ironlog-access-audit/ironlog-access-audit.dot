digraph ironlog_access_audit {
 subgraph cluster_users {
  kind=zone; label="01  PEOPLE";
  users [kind=user-group label="Analysts + auditors" color="#7C3AED" notes="Purple: people. Grafana authenticates its own native local accounts. External IdP integration is deferred."];
 }
 subgraph cluster_apps {
  kind=zone; label="02  APPLICATIONS";
  grafana [kind=container label="Grafana 13.3.0" color="#D97706" notes="Amber: the only UI. Host port 3000. Shared analyst/auditor ClickHouse datasource credentials (svc_grafana_analyst, svc_grafana_auditor). Dashboards, Log Search over siem.log_search, SQL Explore and pipeline health alerts."];
 }
 subgraph cluster_data {
  kind=zone; label="03  DATA SERVICE";
  ch [kind=database label="ClickHouse 26.8" color="#2563EB" notes="Blue: data. ClickHouse 26.8.34.13 LTS. Host 8123/9000 bind to loopback; applications use internal service connectivity. Query log records the shared database service identities (svc_vector, svc_grafana_analyst, svc_grafana_auditor), not individual Grafana users."];
 }
 subgraph cluster_evidence {
  kind=zone; label="04  AUDIT EVIDENCE";
  audit [kind=database label="Query audit archive" color="#2563EB" notes="Blue: data. Logical table audit.query_archive INSIDE ClickHouse, not a separate server. Incremental materialized view from system.query_log; two-year TTL. Not a claim of immutable external storage or complete per-user audit attribution."];
 }
 users -> grafana [label="Local login :3000"];
 grafana -> ch [label="Analyst / auditor SQL"];
 ch -> audit [label="Query log capture"];
}