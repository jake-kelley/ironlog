# ironlog-vector image, role "hosts" (images/vector/): Linux agents (:6000) and
# Kubernetes splunk_hec (:8088). Always on. Config is baked in.
[Unit]
Description=ironlog SIEM - Vector aggregator (Linux hosts + Kubernetes)
# Gated on the schema one-shot, NOT on ClickHouse health (see grafana unit).
After=ironlog-schema.service
Requires=ironlog-schema.service

[Container]
Image=ghcr.io/jake-kelley/ironlog-vector:0.61.0
Pull=never
ContainerName=ironlog-vector-hosts
Network=ironlog.network

Environment=IRONLOG_VECTOR_ROLE=hosts
Environment=CH_VECTOR_PASSWORD=${CH_VECTOR_PASSWORD}
Environment=SPLUNK_HEC_TOKEN=${SPLUNK_HEC_TOKEN}
# Sink address (images/README.md). Default and override: see [Service].
Environment=IRONLOG_CLICKHOUSE_HOST=${IRONLOG_CLICKHOUSE_HOST}
Environment=IRONLOG_CLICKHOUSE_HTTP_PORT=${IRONLOG_CLICKHOUSE_HTTP_PORT}

# Disk buffer (data_dir). Image runs as uid 10001, gid 0.
Volume=/var/lib/ironlog/vector-hosts-buffer:/var/lib/vector:Z

PublishPort=8088:8088
PublishPort=6000:6000

# Exec health probe (the Vector API listens on 127.0.0.1:8686 only).
# HealthStartPeriod avoids a failed first probe leaving the transient health
# unit in `failed` and the system `degraded` (observed 2026-08-18).
HealthCmd=/usr/local/bin/ironlog-healthcheck
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s

[Service]
Environment=IRONLOG_CLICKHOUSE_HOST=ironlog-clickhouse
Environment=IRONLOG_CLICKHOUSE_HTTP_PORT=8123
EnvironmentFile=/etc/ironlog/ironlog.env
Restart=on-failure

[Install]
WantedBy=multi-user.target default.target
