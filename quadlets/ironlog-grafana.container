# Translated from docker-compose.yml: services.grafana
[Unit]
Description=ironlog SIEM — Grafana OSS (dashboards/alerts, local login)
# Gated on ironlog-schema.service, NOT on ironlog-clickhouse.service directly.
# ClickHouse reports healthy on `SELECT 1`, which succeeds against a server
# with an EMPTY database, so depending on it alone let this service start
# happily against a schema-less ClickHouse and silently do nothing (measured
# on real hardware 2026-08-18). ironlog-schema.service Requires= clickhouse
# itself, so ordering is otherwise unchanged.
After=ironlog-schema.service
Requires=ironlog-schema.service

[Container]
Image=docker.io/grafana/grafana-oss:11.4.0
Pull=never
ContainerName=ironlog-grafana
Network=ironlog.network
NetworkAlias=grafana

Environment=GF_AUTH_DISABLE_LOGIN_FORM=false
Environment=GF_AUTH_BASIC_ENABLED=true
Environment=GF_AUTH_ANONYMOUS_ENABLED=false
Environment=GF_USERS_ALLOW_SIGN_UP=false
Environment=GF_AUTH_GENERIC_OAUTH_ENABLED=false

# Renames / URL-composition from ironlog.env's .env.example names:
Environment=GF_SERVER_ROOT_URL=${GRAFANA_ROOT_URL}
Environment=GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER}
Environment=GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
Environment=CH_GRAFANA_ANALYST_PASSWORD=${CH_GRAFANA_ANALYST_PASSWORD}
Environment=CH_GRAFANA_AUDITOR_PASSWORD=${CH_GRAFANA_AUDITOR_PASSWORD}

Volume=/var/lib/ironlog/grafana:/var/lib/grafana:Z
Volume=/opt/ironlog/grafana/provisioning:/etc/grafana/provisioning:ro,Z
Volume=/opt/ironlog/grafana-plugins:/var/lib/grafana/plugins:ro,Z

PublishPort=3000:3000

[Service]
EnvironmentFile=/etc/ironlog/ironlog.env
Restart=on-failure

[Install]
WantedBy=multi-user.target default.target
