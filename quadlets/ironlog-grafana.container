# ironlog-grafana image (images/grafana/): provisioning, dashboards, the
# ClickHouse plugin and the local-auth settings are baked in.
[Unit]
Description=ironlog SIEM - Grafana OSS (dashboards/alerts, local login)
# Gated on the schema one-shot, NOT on ClickHouse health: SELECT 1 succeeds
# against an empty database (measured on real hardware 2026-08-18).
After=ironlog-schema.service
Requires=ironlog-schema.service

[Container]
Image=ghcr.io/jake-kelley/ironlog-grafana:13.3.0
Pull=never
ContainerName=ironlog-grafana
Network=ironlog.network

Environment=GF_SERVER_ROOT_URL=${GRAFANA_ROOT_URL}
Environment=GF_SECURITY_ADMIN_USER=${GRAFANA_ADMIN_USER}
Environment=GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
Environment=CH_GRAFANA_ANALYST_PASSWORD=${CH_GRAFANA_ANALYST_PASSWORD}
Environment=CH_GRAFANA_AUDITOR_PASSWORD=${CH_GRAFANA_AUDITOR_PASSWORD}
# Datasource address (images/README.md). Default and override: see [Service].
Environment=IRONLOG_CLICKHOUSE_HOST=${IRONLOG_CLICKHOUSE_HOST}
Environment=IRONLOG_CLICKHOUSE_NATIVE_PORT=${IRONLOG_CLICKHOUSE_NATIVE_PORT}

# Image runs as uid 472; the host directory must be owned by it.
Volume=/var/lib/ironlog/grafana:/var/lib/grafana:Z

PublishPort=3000:3000

HealthCmd=wget -q -O /dev/null http://127.0.0.1:3000/api/health
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s

[Service]
Environment=IRONLOG_CLICKHOUSE_HOST=ironlog-clickhouse
Environment=IRONLOG_CLICKHOUSE_NATIVE_PORT=9000
EnvironmentFile=/etc/ironlog/ironlog.env
Restart=on-failure

[Install]
WantedBy=multi-user.target default.target
