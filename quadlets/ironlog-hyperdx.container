# Translated from docker-compose.yml: services.hyperdx
# NOT published to the host — reached only through ironlog-hyperdx-auth.
[Unit]
Description=ironlog SIEM — HyperDX (ClickStack search/investigation UI over siem.*)
# compose: depends_on clickhouse healthy, hyperdx-db healthy. Both those
# units set Notify=healthy, so After+Requires genuinely waits for both.
After=ironlog-clickhouse.service ironlog-hyperdx-db.service
Requires=ironlog-clickhouse.service ironlog-hyperdx-db.service

[Container]
Image=docker.hyperdx.io/hyperdx/hyperdx:2.19.0
ContainerName=ironlog-hyperdx
Network=ironlog.network
NetworkAlias=hyperdx

# The oauth2-proxy URL the browser sees. Derived from APPLIANCE_FQDN by first
# boot; compose's localhost literal is wrong for a real appliance.
Environment=FRONTEND_URL=$HYPERDX_PUBLIC_URL
Environment=HYPERDX_APP_PORT=8080
Environment=HYPERDX_API_PORT=8000
Environment=HYPERDX_LOG_LEVEL=info
# Suppresses the 4-hourly phone-home to in-otel.hyperdx.io — do not drop.
Environment=USAGE_STATS_ENABLED=false

# MONGO_URI has one secret ($CH...no, $HYPERDX_DB_PASSWORD) embedded in an
# otherwise-static URI. No spaces/quotes in a URI, so no unit-file quoting
# is needed — plain systemd $VAR substitution from ironlog.env is safe here.
# hyperdx-db is the NetworkAlias other units resolve; do not change.
Environment=MONGO_URI=mongodb://hyperdx:$HYPERDX_DB_PASSWORD@hyperdx-db:27017/hyperdx?authSource=admin

# DEFAULT_CONNECTIONS has one secret ($CH_HYPERDX_PASSWORD) embedded inside
# JSON containing a space ("SIEM ClickHouse") and nested double quotes, so it
# DOES need unit-file quoting (outer "..." with internal " escaped as \").
# See quadlets/README.md "Secret handling" for why this, unlike
# DEFAULT_SOURCES, could not simply be baked as a static file.
Environment="DEFAULT_CONNECTIONS=[{\"name\":\"SIEM ClickHouse\",\"host\":\"http://clickhouse:8123\",\"username\":\"svc_hyperdx\",\"password\":\"$CH_HYPERDX_PASSWORD\"}]"

# DEFAULT_SOURCES carries no secrets; baked as a static file (see
# quadlets/hyperdx/default-sources.env) and loaded verbatim — safer than
# fighting unit-file quoting for a value this large.
EnvironmentFile=/opt/ironlog/hyperdx/default-sources.env

[Service]
EnvironmentFile=/etc/ironlog/ironlog.env
Restart=on-failure

[Install]
WantedBy=multi-user.target default.target
