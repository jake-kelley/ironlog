# Baked, non-secret config for the hyperdx container's DEFAULT_SOURCES env var.
# Deploy this file to /opt/ironlog/hyperdx/default-sources.env and reference
# it from ironlog-hyperdx.container via an extra [Container] EnvironmentFile=.
#
# WHY THIS EXISTS (see quadlets/README.md "Secret handling" section for the
# full explanation): DEFAULT_SOURCES is one giant single-line JSON value
# containing spaces, nested double quotes, and doubled single-quotes (SQL
# string-escaping inside JSON string values, e.g. '':''). Embedding that
# safely as an inline [Container] Environment= value in a quadlet unit file
# would require escaping every one of those characters against systemd's own
# unit-file quoting rules — fragile and unverifiable without a live podman/
# systemd to test against. DEFAULT_SOURCES carries NO secrets (unlike
# DEFAULT_CONNECTIONS, which does and stays inline in ironlog-hyperdx.container
# using systemd $VAR substitution from ironlog.env), so it is safe to bake as
# a literal, unquoted file value instead: systemd's EnvironmentFile parser
# takes everything after the first `=` verbatim to end-of-line when the value
# has no leading/trailing quote character and no backslashes (true here — the
# value starts with `[` and ends with `]`), so no escaping is needed.
#
# Verbatim copy of docker-compose.yml's services.hyperdx.environment.DEFAULT_SOURCES.
DEFAULT_SOURCES=[{"from":{"databaseName":"siem","tableName":"cloudtrail"},"kind":"log","name":"CloudTrail","timestampValueExpression":"event_time","displayedTimestampValueExpression":"event_time","implicitColumnExpression":"raw","bodyExpression":"raw","serviceNameExpression":"event_source","defaultTableSelectExpression":"event_time,event_name,principal_arn,source_ip,error_code","connection":"SIEM ClickHouse"},{"from":{"databaseName":"siem","tableName":"guardduty"},"kind":"log","name":"GuardDuty","timestampValueExpression":"event_time","displayedTimestampValueExpression":"event_time","implicitColumnExpression":"title","bodyExpression":"title","serviceNameExpression":"finding_type","defaultTableSelectExpression":"event_time,finding_type,severity,resource_type,resource_id,title","connection":"SIEM ClickHouse"},{"from":{"databaseName":"siem","tableName":"vpc_flow"},"kind":"log","name":"VPC Flow","timestampValueExpression":"event_time","displayedTimestampValueExpression":"event_time","implicitColumnExpression":"interface_id","bodyExpression":"concat(toString(src_addr),'':'',toString(src_port),'' -> '',toString(dst_addr),'':'',toString(dst_port))","defaultTableSelectExpression":"event_time,aws_account,src_addr,src_port,dst_addr,dst_port,protocol,action,bytes","connection":"SIEM ClickHouse"},{"from":{"databaseName":"siem","tableName":"s3_access"},"kind":"log","name":"S3 Access","timestampValueExpression":"event_time","displayedTimestampValueExpression":"event_time","implicitColumnExpression":"object_key","bodyExpression":"concat(operation,'' '',object_key)","serviceNameExpression":"bucket","defaultTableSelectExpression":"event_time,bucket,operation,object_key,remote_ip,http_status","connection":"SIEM ClickHouse"}]
