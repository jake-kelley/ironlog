# ironlog-clickhouse image (images/clickhouse/): config, lockdown and DDL are
# baked in. No config bind mounts; only the data directory is mounted.
[Unit]
Description=ironlog SIEM - ClickHouse storage/query engine
# No dependencies of its own; ironlog-schema.service and the rest wait on it.

[Container]
Image=ghcr.io/jake-kelley/ironlog-clickhouse:26.8.34.13
# Pull=never: load or pull the image first (quadlets/README.md "Images").
Pull=never
ContainerName=ironlog-clickhouse
Network=ironlog.network

# ironlog.env uses the .env.example names (CH_ADMIN_USER, ...); the image
# expects CLICKHOUSE_USER / CLICKHOUSE_PASSWORD (images/README.md). Quadlet
# cannot rename variables, so [Service] EnvironmentFile= loads ironlog.env into
# the unit environment and systemd substitutes the values into the generated
# `podman run` command line. See quadlets/README.md "Secret handling".
Environment=CLICKHOUSE_USER=${CH_ADMIN_USER}
Environment=CLICKHOUSE_PASSWORD=${CH_ADMIN_PASSWORD}
Environment=CH_VECTOR_PASSWORD=${CH_VECTOR_PASSWORD}
Environment=CH_GRAFANA_ANALYST_PASSWORD=${CH_GRAFANA_ANALYST_PASSWORD}
Environment=CH_GRAFANA_AUDITOR_PASSWORD=${CH_GRAFANA_AUDITOR_PASSWORD}

# Data (bind mount, writable). The image runs as uid 10001, gid 0: the host
# directory must be writable by it (quadlets/README.md "Data directories").
Volume=/var/lib/ironlog/clickhouse:/var/lib/clickhouse:Z

# Ports are loopback-only BY DEFAULT: ClickHouse is admin-only and this is a
# deliberate security property (CLAUDE.md, docs/control-mapping.md CM-7). For
# split-host mode set IRONLOG_CLICKHOUSE_BIND in /etc/ironlog/ironlog.env to
# this host's private address AFTER reading quadlets/README.md "Split-host
# mode": it exposes the ClickHouse login surface to that network.
# The [Service] Environment= below supplies the loopback default, because
# systemd has no ${VAR:-default} syntax and an empty value would publish on
# all interfaces. Never set the variable to an empty string.
PublishPort=${IRONLOG_CLICKHOUSE_BIND}:8123:8123
PublishPort=${IRONLOG_CLICKHOUSE_BIND}:9000:9000

Ulimit=nofile=262144:262144

# Same command as the image HEALTHCHECK; explicit because a podman-built OCI
# image drops HEALTHCHECK. It reads the container's own CLICKHOUSE_* env.
# Health only means SELECT 1 works; schema readiness is ironlog-schema.service.
HealthCmd=/usr/local/bin/ironlog-healthcheck
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=60s

[Service]
# Default, overridden by IRONLOG_CLICKHOUSE_BIND in ironlog.env (systemd.exec:
# EnvironmentFile= values override Environment=).
Environment=IRONLOG_CLICKHOUSE_BIND=127.0.0.1
EnvironmentFile=/etc/ironlog/ironlog.env
Restart=on-failure

[Install]
WantedBy=multi-user.target default.target
