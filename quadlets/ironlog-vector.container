# ironlog-vector image, role "aws" (images/vector/): AWS ingestion (CloudTrail,
# GuardDuty, VPC Flow, S3 Access via SQS+S3). Compose gates this behind the
# "aws" profile; it SHIPS DISABLED here for the same reason: deliberately NO
# [Install] section, so it does not start at boot. See quadlets/README.md
# "Enabling ironlog-vector.service".
[Unit]
Description=ironlog SIEM - Vector aggregator (AWS ingestion: CloudTrail/GuardDuty/VPC Flow/S3 Access via SQS+S3)
# Gated on the schema one-shot, NOT on ClickHouse health (see grafana unit).
After=ironlog-schema.service
Requires=ironlog-schema.service

[Container]
Image=ghcr.io/jake-kelley/ironlog-vector:0.61.0
Pull=never
ContainerName=ironlog-vector
Network=ironlog.network

Environment=IRONLOG_VECTOR_ROLE=aws
Environment=CH_VECTOR_PASSWORD=${CH_VECTOR_PASSWORD}
Environment=IRONLOG_CLICKHOUSE_HOST=${IRONLOG_CLICKHOUSE_HOST}
Environment=IRONLOG_CLICKHOUSE_HTTP_PORT=${IRONLOG_CLICKHOUSE_HTTP_PORT}
# compose defaults AWS_REGION to us-east-1; systemd has no ${VAR:-default}.
# ASSUMPTION: the secret resolver always writes a concrete AWS_REGION into
# ironlog.env. Static keys are optional (an instance role works).
Environment=AWS_REGION=${AWS_REGION}
Environment=AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
Environment=AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
Environment=SQS_URL_CLOUDTRAIL=${SQS_URL_CLOUDTRAIL}
Environment=SQS_URL_GUARDDUTY=${SQS_URL_GUARDDUTY}
Environment=SQS_URL_VPCFLOW=${SQS_URL_VPCFLOW}
Environment=SQS_URL_S3ACCESS=${SQS_URL_S3ACCESS}

Volume=/var/lib/ironlog/vector-buffer:/var/lib/vector:Z

HealthCmd=/usr/local/bin/ironlog-healthcheck
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s

# No PublishPort: the port 8088 source belongs to vector-hosts.

[Service]
Environment=IRONLOG_CLICKHOUSE_HOST=ironlog-clickhouse
Environment=IRONLOG_CLICKHOUSE_HTTP_PORT=8123
EnvironmentFile=/etc/ironlog/ironlog.env
Restart=on-failure

# Deliberately no [Install] section.
